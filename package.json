{
  "name": "weixin-codex-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone WeChat iLink bridge and Codex MCP plugin",
  "scripts": {
    "build": "npm run check && npm run package:plugin",
    "build:plugin": "node scripts/build-plugin-mcp.mjs",
    "package:plugin": "node scripts/build-plugin-mcp.mjs",
    "check": "tsc -p tsconfig.json",
    "dev:mcp": "node --import tsx src/mcp/server.ts",
    "login": "node --import tsx src/cli/login.ts",
    "bridge": "node --import tsx src/cli/bridge.ts",
    "queue:list": "node --import tsx src/cli/queue-list.ts",
    "queue:pop": "node --import tsx src/cli/queue-pop.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.11",
    "@types/node": "^22.15.21",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
